#!/usr/bin/env python3
# description: 系统综合诊断（内核、CPU、内存、磁盘、网络、Docker、Git）
"""System diagnostic — collects all key metrics."""
import subprocess as sp, json

def run(cmd):
    return sp.run(cmd, shell=True, capture_output=True, text=True, timeout=10).stdout.strip()

result = {
    "hostname": run("hostname"),
    "kernel": run("uname -r"),
    "uptime": run("uptime -p"),
    "cpu_model": run("lscpu | grep 'Model name' | sed 's/.*: *//'"),
    "cpu_cores": run("nproc"),
    "load": run("cat /proc/loadavg | awk '{print $1,$2,$3}'"),
    "memory": run("free -h | grep 'Mem:' | awk '{print $2,$3,$4}'"),
    "disk_root": run("df -h / | tail -1 | awk '{print $2,$3,$4,$5}'"),
    "net_interfaces": run("ip -br addr | grep -v lo | awk '{print $1,$3}'"),
    "dns": run("grep nameserver /etc/resolv.conf | awk '{print $2}' | head -1"),
    "docker": run("docker ps --format '{{.Names}} {{.Status}}' 2>/dev/null | head -5") or "none",
    "git": run("git --version 2>/dev/null") or "not installed",
}
print(json.dumps(result, indent=2, ensure_ascii=False))
